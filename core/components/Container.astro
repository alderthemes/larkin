---
/**
 * Container — centres page content and supplies the horizontal padding.
 * Width comes from a token (--ts-container-max); a template may override it.
 */
interface Props {
  /**
   * "prose" is a reading column, not a layout width: use it for a block that
   * is mostly sentences. The others are layout.
   */
  size?: "default" | "narrow" | "wide" | "prose";
  class?: string;
}
const { size = "default", class: className = "" } = Astro.props;
const WIDTHS = {
  prose: "var(--ts-prose-max)",
  narrow: "48rem",
  wide: "80rem",
  default: "var(--ts-container-max)",
};
const maxWidth = WIDTHS[size] ?? WIDTHS.default;
---

<div class:list={["ts-container", className]} style={`max-width:${maxWidth}`}>
  <slot />
</div>

<style>
  .ts-container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--ts-container-pad);
  }
  @media (min-width: 640px) {
    .ts-container {
      padding-inline: var(--ts-space-6);
    }
  }
</style>
