---
/**
 * LocationCard — address, today's hours, amenities and directions.
 *
 * Sits beside the hero on the home page and inside a grid on the contact
 * page. No shadow, deliberately: this card carries information, it is not a
 * clickable surface, and a shadow would promise an interaction that is not
 * there.
 */
import Button from "@studio/core/components/Button.astro";
import OpenStatus from "./OpenStatus.astro";
import { t } from "../lib/site";
import { formatAddress, weeklyRanges, dayLabels, WEEK_ORDER, type Location } from "../lib/locations";

interface Props {
  location: Location;
  /** Show the full week inside an expandable <details> */
  showAllHours?: boolean;
  headingLevel?: "h2" | "h3";
  class?: string;
}
const {
  location,
  showAllHours = false,
  headingLevel: Heading = "h3",
  class: className = "",
} = Astro.props;

const d = location.data;
const address = formatAddress(location);
const ranges = weeklyRanges(location);
const DAY_KEYS = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];
const DAY_LABELS = dayLabels(t);
/* Start on Monday, the order people expect to read a week in */
const week = WEEK_ORDER.map((i) => ({
  key: DAY_KEYS[i],
  label: DAY_LABELS[i],
  range: ranges[i],
}));

const amenities = [
  d.wifi ? t("location.wifi") : null,
  d.outlets ? t("location.outlets") : null,
  d.laptopFriendly ? t("location.laptopFriendly") : null,
].filter(Boolean) as string[];
---

<article class:list={["loc-card", className]}>
  <Heading class="loc-card__name">{d.name}</Heading>

  <p class="loc-card__address">
    <svg class="loc-card__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z" />
      <circle cx="12" cy="10" r="2.5" />
    </svg>
    <span>{address}</span>
  </p>

  <OpenStatus location={location} class="loc-card__hours" />

  {
    showAllHours && (
      <details class="loc-card__all-hours">
        <summary>{t("location.allHours")}</summary>
        <dl class="loc-card__week">
          {week.map((day) => (
            <div class="loc-card__week-row">
              <dt>{day.label}</dt>
              <dd>{day.range || t("location.closedNow")}</dd>
            </div>
          ))}
        </dl>
      </details>
    )
  }

  {
    amenities.length > 0 && (
      <p class="loc-card__amenities">
        <span class="loc-card__amenities-label">{t("location.amenities")}:</span>{" "}
        {amenities.join(" · ")}
      </p>
    )
  }

  <p class="loc-card__walkin">{t("location.walkInOnly")}</p>

  {
    d.mapUrl && (
      <div class="loc-card__actions">
        <Button
          href={d.mapUrl}
          variant="secondary"
          size="sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("location.directions")}
        </Button>
      </div>
    )
  }
</article>

<style>
  /* No box of its own: the card takes the surface it is placed on (the
     gusset on the contact page, a label on the home page when there is more
     than one shop) and prints in that surface's inks. Its parts are divided
     by rules, like the lines of a printed label. */
  .loc-card {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-3);
    min-width: 0;
  }
  .loc-card__name {
    margin: 0;
    font-family: var(--ts-font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    overflow-wrap: break-word;
  }
  .loc-card__address {
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--ts-space-2);
    font-weight: 550;
  }
  .loc-card__icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 0.2em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .loc-card__all-hours summary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--lk-ink, currentColor);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    font-weight: 650;
    border-radius: var(--ts-radius-sm);
  }
  .loc-card__week {
    margin: 0;
    display: grid;
    gap: 0;
    max-width: 24rem;
  }
  .loc-card__week-row {
    display: flex;
    /* Let the day and the hours drop onto two lines when they no longer fit
       side by side, which is what happens at 200% text. */
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--ts-space-4);
    padding-block: var(--ts-space-2);
    border-bottom: 1px solid var(--lk-rule, currentColor);
  }
  .loc-card__week-row:last-child {
    border-bottom: none;
  }
  .loc-card__week dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
  }
  .loc-card__amenities,
  .loc-card__walkin {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--lk-ink-soft, currentColor);
  }
  .loc-card__amenities {
    padding-top: var(--ts-space-3);
    border-top: 1px solid var(--lk-rule, currentColor);
  }
  .loc-card__amenities-label {
    font-weight: 700;
  }
  .loc-card__actions {
    margin-top: var(--ts-space-1);
  }
</style>
