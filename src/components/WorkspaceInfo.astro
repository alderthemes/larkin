---
/**
 * WorkspaceInfo — the "can I work here?" block.
 * Four facts: wifi, power outlets, noise level, laptop policy. Answering
 * honestly, including with a no, is what earns trust here; hiding the laptop
 * policy is the most common mistake a cafe site makes, and it costs the shop
 * the visit either way.
 */
import Container from "@studio/core/components/Container.astro";
import SectionHeading from "@studio/core/components/SectionHeading.astro";
import { t } from "../lib/site";

const facts = [
  { key: "wifi", title: t("workspace.wifiTitle"), body: t("workspace.wifiBody") },
  { key: "power", title: t("workspace.powerTitle"), body: t("workspace.powerBody") },
  { key: "noise", title: t("workspace.noiseTitle"), body: t("workspace.noiseBody") },
  { key: "laptop", title: t("workspace.laptopTitle"), body: t("workspace.laptopBody") },
];
---

<section class="workspace" id="workspace">
  <Container>
    <div class="workspace__inner">
      <SectionHeading
        eyebrow={t("workspace.eyebrow")}
        title={t("workspace.title")}
        subtitle={t("workspace.lead")}
      />
      <dl class="workspace__grid">
        {
          facts.map((fact) => (
            <div class="workspace__item">
              <dt class="workspace__term">{fact.title}</dt>
              <dd class="workspace__def">{fact.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Container>
</section>

<style>
  /* The ground color, not the alternate: next to the featured menu the two
     alternate blocks read as one gray slab and hid where one ended. */
  .workspace {
    padding-block: var(--ts-section-y);
    background: var(--ts-surface);
  }
  .workspace__inner {
    max-width: 46rem;
  }
  /* Heading left, facts right: the section uses the full frame. */
  @media (min-width: 1024px) {
    .workspace__inner {
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--ts-space-16);
      align-items: start;
    }
    .workspace__grid {
      margin-top: 0;
    }
  }
  .workspace__grid {
    margin: var(--ts-space-10) 0 0;
    display: grid;
    gap: var(--ts-space-6);
  }
  @media (min-width: 640px) {
    .workspace__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--ts-space-8);
    }
  }
  .workspace__item {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-1);
    padding-left: var(--ts-space-4);
    /* A neutral hairline. The layout does the grouping; the accent is kept
       for the seasonal mark and the current page. */
    border-left: 1px solid var(--ts-border-strong);
  }
  .workspace__term {
    font-size: var(--ts-text-base);
    font-weight: var(--ts-weight-semibold);
    color: var(--ts-color-primary-900);
  }
  .workspace__def {
    margin: 0;
    font-size: var(--ts-text-sm);
    color: var(--ts-text-muted);
  }
</style>
