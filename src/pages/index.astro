---
/**
 * Ana sayfa — cafe ziyaretçisinin ilk 10 saniyesi (research.md §4):
 * nerede, açık mı, ne var, çalışılır mı. Konum kartı İLK EKRANDA.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@studio/core/components/Container.astro";
import Button from "@studio/core/components/Button.astro";
import SectionHeading from "@studio/core/components/SectionHeading.astro";
import LocationCard from "../components/LocationCard.astro";
import OpenStatus from "../components/OpenStatus.astro";
import MenuList from "../components/MenuList.astro";
import WorkspaceInfo from "../components/WorkspaceInfo.astro";
import GalleryStrip from "../components/GalleryStrip.astro";
import FaqList from "../components/FaqList.astro";
import { t, business } from "../lib/site";
import { getLocations, formatAddress, openingHours } from "../lib/locations";
import { cafeSchema, faqSchema } from "@studio/core/utils/seo";

const locations = await getLocations();
const primary = locations.find((l) => l.data.primary) ?? locations[0];
const featured = (await getCollection("menu"))
  .filter((i) => i.data.featured && i.data.available)
  .sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);

const heroImages = import.meta.glob<{ default: ImageMetadata }>("../assets/images/01-hero*.jpg", {
  eager: true,
});
const hero = Object.values(heroImages)[0]?.default;

const url = new URL("/", Astro.site).toString();
const schema = [
  cafeSchema({
    name: business.name,
    description: t("hero.lead"),
    url,
    telephone: business.phone,
    email: business.email,
    priceRange: business.priceRange,
    servesCuisine: business.servesCuisine,
    acceptsReservations: false,
    menuUrl: new URL("/menu/", Astro.site).toString(),
    streetAddress: primary?.data.streetAddress,
    addressLocality: primary?.data.addressLocality,
    addressRegion: primary?.data.addressRegion,
    postalCode: primary?.data.postalCode,
    addressCountry: primary?.data.addressCountry,
    openingHours: primary ? openingHours(primary) : [],
  }),
  faqSchema(faqs.map((f) => ({ question: f.data.question, answer: f.data.answer }))),
];
---

<BaseLayout title={t("hero.title")} description={t("hero.lead")} schema={schema}>
  <!-- Hero: mekan hissi + konum kartı ilk ekranda (ui-spec §5.2) -->
  <section class="hero">
    <Container>
      <div class="hero__grid">
        <div class="hero__content">
          <p class="hero__eyebrow">{t("hero.eyebrow")}</p>
          <h1 class="hero__title">{t("hero.title")}</h1>
          <p class="hero__lead">{t("hero.lead")}</p>

          {/* AK-1: "nerede ve açık mı" ilk ekranda olmalı. 390×844'te tam
              konum kartı katlamanın altında kalıyordu; bu iki satırlık şerit
              kritik cevabı hero'nun içine taşır, kart detayı aşağıda kalır. */}
          {
            primary && (
              <div class="hero__meta">
                <p class="hero__address">{formatAddress(primary)}</p>
                <OpenStatus location={primary} />
              </div>
            )
          }

          <div class="hero__actions">
            {
              primary?.data.mapUrl && (
                <Button
                  href={primary.data.mapUrl}
                  variant="primary"
                  size="lg"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t("hero.primaryCta")}
                </Button>
              )
            }
            <Button href="/menu/" variant="secondary" size="lg">
              {t("hero.secondaryCta")}
            </Button>
          </div>
        </div>

        {
          hero && (
            <div class="hero__media">
              <Image
                src={hero}
                alt={t("hero.imageAlt")}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1024px) 46rem, 100vw"
                loading="eager"
                fetchpriority="high"
                class="hero__img"
              />
            </div>
          )
        }
      </div>

      {
        primary && (
          <div class="hero__location">
            <LocationCard location={primary} headingLevel="h2" />
            {locations.length > 1 && (
              <p class="hero__all-locations">
                <a href="/contact/">{t("location.viewAll")}</a>
              </p>
            )}
          </div>
        )
      }
    </Container>
  </section>

  <!-- Menü öne çıkanları -->
  {
    featured.length > 0 && (
      <section class="featured">
        <Container>
          <SectionHeading
            eyebrow={t("menu.eyebrow")}
            title={t("menu.title")}
            subtitle={t("menu.subtitle")}
          />
          <div class="featured__list">
            <MenuList
              items={featured}
              categories={[...new Set(featured.map((i) => i.data.category))]}
              headingLevel="h3"
            />
          </div>
          <p class="featured__cta">
            <Button href="/menu/" variant="secondary">
              {t("menu.viewFull")}
            </Button>
          </p>
        </Container>
      </section>
    )
  }

  <WorkspaceInfo />

  <GalleryStrip />

  <!-- SSS -->
  {
    faqs.length > 0 && (
      <section class="faq-section" id="faq">
        <Container>
          <SectionHeading
            eyebrow={t("faq.eyebrow")}
            title={t("faq.title")}
            subtitle={t("faq.subtitle")}
          />
          <div class="faq-section__list">
            <FaqList items={faqs} />
          </div>
        </Container>
      </section>
    )
  }

  <!-- İletişim kısayolu -->
  <section class="say-hello">
    <Container>
      <div class="say-hello__inner">
        <SectionHeading
          eyebrow={t("contact.eyebrow")}
          title={t("contact.title")}
          subtitle={t("contact.subtitle")}
        />
        <div class="say-hello__actions">
          <Button href="/contact/" variant="primary">{t("contact.form.submit")}</Button>
          {primary && <p class="say-hello__address">{formatAddress(primary)}</p>}
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--ts-space-10) var(--ts-section-y);
  }
  @media (min-width: 768px) {
    .hero {
      padding-block: var(--ts-space-16) var(--ts-section-y);
    }
  }
  .hero__grid {
    display: grid;
    gap: var(--ts-space-10);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--ts-space-16);
    }
  }
  .hero__eyebrow {
    margin: 0 0 var(--ts-space-3);
    font-size: var(--ts-text-xs);
    font-weight: var(--ts-weight-semibold);
    letter-spacing: var(--ts-tracking-wide);
    text-transform: uppercase;
    color: var(--ts-color-accent-600);
  }
  .hero__title {
    margin: 0;
    font-family: var(--ts-font-display);
    font-size: var(--ts-text-display);
    font-weight: var(--ts-weight-bold);
    line-height: var(--ts-leading-display);
    letter-spacing: var(--ts-tracking-tight);
    color: var(--ts-color-primary-900);
  }
  .hero__lead {
    margin: var(--ts-space-5) 0 0;
    font-size: var(--ts-text-lg);
    line-height: var(--ts-leading-body);
    color: var(--ts-text-muted);
    max-width: 46ch;
  }
  .hero__meta {
    margin-top: var(--ts-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-1);
    padding-left: var(--ts-space-4);
    border-left: 2px solid var(--ts-color-accent-400);
  }
  .hero__address {
    margin: 0;
    font-size: var(--ts-text-sm);
    font-weight: var(--ts-weight-medium);
    color: var(--ts-color-primary-700);
  }
  .hero__actions {
    margin-top: var(--ts-space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--ts-space-3);
  }
  .hero__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--ts-radius-xl);
  }
  .hero__location {
    margin-top: var(--ts-space-12);
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-3);
    max-width: 32rem;
  }
  .hero__all-locations {
    margin: 0;
    font-size: var(--ts-text-sm);
  }
  .hero__all-locations a {
    color: var(--ts-color-accent-600);
  }

  .featured {
    padding-block: var(--ts-section-y);
    background: var(--ts-surface-alt);
  }
  .featured__list {
    margin-top: var(--ts-space-10);
    max-width: 44rem;
  }
  .featured__cta {
    margin: var(--ts-space-10) 0 0;
  }

  .faq-section {
    padding-block: var(--ts-section-y);
  }
  .faq-section__list {
    margin-top: var(--ts-space-10);
  }

  .say-hello {
    padding-block: var(--ts-section-y);
    background: var(--ts-surface-alt);
  }
  .say-hello__inner {
    max-width: 46rem;
  }
  .say-hello__actions {
    margin-top: var(--ts-space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ts-space-6);
  }
  .say-hello__address {
    margin: 0;
    font-size: var(--ts-text-sm);
    color: var(--ts-text-muted);
  }
</style>
