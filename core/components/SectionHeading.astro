---
/**
 * SectionHeading — the eyebrow + title + subtitle trio.
 * The standard opening block of a section; alignment is chosen by prop.
 */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "start" | "center";
  /** Heading tag — h1/h2/h3, chosen to fit the page's heading hierarchy */
  level?: "h1" | "h2" | "h3";
  class?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  align = "start",
  level: Heading = "h2",
  class: className = "",
} = Astro.props;
---

<header class:list={["ts-heading", `ts-heading--${align}`, className]}>
  {eyebrow && <p class="ts-heading__eyebrow">{eyebrow}</p>}
  <Heading class="ts-heading__title">{title}</Heading>
  {subtitle && <p class="ts-heading__subtitle">{subtitle}</p>}
</header>

<style>
  .ts-heading {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-3);
    max-width: 44rem;
  }
  .ts-heading--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .ts-heading__eyebrow {
    margin: 0;
    font-size: var(--ts-c-section-eyebrow-size);
    font-weight: var(--ts-c-section-eyebrow-weight);
    letter-spacing: var(--ts-c-section-eyebrow-tracking);
    text-transform: uppercase;
    color: var(--ts-c-section-eyebrow-color);
  }
  .ts-heading__title {
    margin: 0;
    font-family: var(--ts-font-display);
    font-size: var(--ts-text-2xl);
    line-height: var(--ts-leading-tight);
    letter-spacing: var(--ts-tracking-tight);
    font-weight: var(--ts-weight-bold);
    color: var(--ts-c-section-heading-color);
    text-wrap: balance;
  }
  .ts-heading__subtitle {
    margin: 0;
    font-size: var(--ts-text-lg);
    line-height: var(--ts-leading-snug);
    /* The component token, matching --ts-c-section-heading-color which the
       title already reads. The subtitle went straight to the semantic token,
       so a theme overriding the component layer changed the title and not the
       line under it. */
    color: var(--ts-c-section-subheading-color);
  }
  @media (min-width: 768px) {
    .ts-heading__title { font-size: var(--ts-text-3xl); }
  }
</style>
