---
/**
 * BaseLayout — the site shell. The search and link-preview tags come from
 * core's SeoHead; this layout adds the share-image size, the language tag,
 * the font preloads and the browser color to it. A page passes its own
 * structured data through the `schema` prop.
 */
import "../styles/global.css";
import "../styles/larkin.css";
import SeoHead from "@studio/core/components/SeoHead.astro";
import { LOCALE, t, business } from "../lib/site";
import { THEME_COLOR } from "../lib/theme-color";
import { FONT_PRELOADS } from "../lib/font-preloads";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SealDefs from "../components/SealDefs.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: unknown;
  noindex?: boolean;
}

const { title, description, image = "/og.jpg", schema, noindex = false } = Astro.props;
const siteName = business.name;
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <SeoHead
      title={title}
      siteName={siteName}
      description={description}
      image={image}
      noindex={noindex}
      schema={schema}
    >
      {/* The shipped og.jpg is exactly 1200x630. Declaring it lets a share
          client draw the large card immediately instead of downloading the file
          first to find out — the difference between a big card and a small one
          on the first share of a link. Replace the numbers if you replace the
          image with a different size. */}
      {image === "/og.jpg" && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={t("a11y.ogImageAlt")} />
        </>
      )}
      <meta property="og:locale" content={LOCALE === "tr" ? "tr_TR" : "en_US"} />

      {/* Fonts are self-hosted through @fontsource, imported from global.css.
          No request leaves the visitor's browser for a font file.

          Without the preload the browser learns the font exists only after the
          stylesheet has parsed, so the chain is HTML -> CSS -> font and the page
          paints once in the fallback face and again in the real one (the
          fallback faces in larkin.css are sized to match, so the swap does not
          move the lines). Which files are preloaded follows the font tokens in
          global.css (src/lib/font-preloads.ts).
          `crossorigin` is required even for a same-origin font, because fonts
          are fetched in CORS mode - without it the browser downloads the file
          twice. */}
      {FONT_PRELOADS.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
      {/* The phone browser paints its own bar in the bag's terracotta, read
          from global.css (src/lib/theme-color.ts). */}
      {THEME_COLOR && <meta name="theme-color" content={THEME_COLOR} />}
    </SeoHead>
  </head>
  <body class="larkin">
    <a href="#main" class="skip-link">{t("a11y.skipToContent")}</a>
    <SealDefs />
    {/* The top of the bag: its heat-sealed edge, then the bag itself, which
        carries the header and every page. The footer is the base, under a
        second sealed edge. */}
    <div class="larkin-crimp larkin-crimp--top" aria-hidden="true"></div>
    <div class="larkin-bag">
      <SiteHeader />
      {/* tabindex="-1" makes <main> focusable by script and by a fragment
          link without putting it in the tab order. Without it the skip link
          moves the sequential starting point but leaves focus on <body>:
          Chrome papers over the difference, Safari and some screen readers
          historically do not. */}
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <div class="larkin-crimp larkin-crimp--bottom" aria-hidden="true"></div>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--ts-space-4);
    top: calc(-1 * var(--ts-space-24));
    z-index: var(--ts-z-skip);
    background: var(--ts-text);
    color: var(--larkin-sticker);
    padding: var(--ts-space-3) var(--ts-space-4);
    border-radius: var(--ts-radius-full);
    font-weight: var(--ts-weight-semibold);
    transition: top calc(var(--ts-duration-fast) * var(--larkin-motion, 1)) var(--ts-ease-out);
  }
  .skip-link:focus-visible {
    top: var(--ts-space-4);
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
