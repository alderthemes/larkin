---
/**
 * WorkspaceInfo — the "can I work here?" block.
 * Four facts: wifi, power outlets, noise level, laptop policy. Answering
 * honestly, including with a no, is what earns trust here; hiding the laptop
 * policy is the most common mistake a cafe site makes, and it costs the shop
 * the visit either way.
 *
 * It is the side gusset of the bag: a narrow fern-green fold standing next
 * to the menu label on the home page, the four facts read top to bottom
 * like the notes printed down a gusset.
 */
import SectionHeading from "@studio/core/components/SectionHeading.astro";
import { t } from "../lib/site";

const facts = [
  { key: "wifi", title: t("workspace.wifiTitle"), body: t("workspace.wifiBody") },
  { key: "power", title: t("workspace.powerTitle"), body: t("workspace.powerBody") },
  { key: "noise", title: t("workspace.noiseTitle"), body: t("workspace.noiseBody") },
  { key: "laptop", title: t("workspace.laptopTitle"), body: t("workspace.laptopBody") },
];
---

<section class="workspace larkin-panel larkin-panel--gusset" id="workspace">
  <div class="workspace__inner">
    <SectionHeading
      eyebrow={t("workspace.eyebrow")}
      title={t("workspace.title")}
      subtitle={t("workspace.lead")}
      class="workspace__heading"
    />
    <dl class="workspace__grid">
      {
        facts.map((fact) => (
          <div class="workspace__item">
            <dt class="workspace__term">{fact.title}</dt>
            <dd class="workspace__def">{fact.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .workspace {
    padding-block: clamp(2.5rem, 5vw, 4.25rem) clamp(2.5rem, 5vw, 3.5rem);
    scroll-margin-top: calc(var(--ts-c-nav-height) + var(--ts-space-4));
  }
  .workspace :global(.workspace__heading) {
    gap: var(--ts-space-4);
  }
  .workspace :global(.workspace__heading .ts-heading__title) {
    font-family: var(--ts-font-display);
    font-size: clamp(2rem, 3.3vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: inherit;
  }
  .workspace :global(.workspace__heading .ts-heading__subtitle) {
    font-size: 1rem;
    line-height: 1.55;
  }
  .workspace__grid {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
  }
  .workspace__item {
    padding-block: var(--ts-space-4);
    border-top: 2px solid var(--lk-rule);
  }
  /* The terms are the gusset's voice: the display face, large, one per line
     like the notes printed down the side of a bag. */
  .workspace__term {
    font-family: var(--ts-font-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    font-size: clamp(1.6rem, 2.3vw, 2.125rem);
    overflow-wrap: break-word;
  }
  .workspace__def {
    margin: var(--ts-space-2) 0 0;
    font-size: 1rem;
    line-height: 1.55;
  }
  /* A tablet is wide for one narrow column and narrow for the menu beside
     it: the four facts pair up. */
  @media (min-width: 640px) and (max-width: 999.98px) {
    .workspace__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--ts-space-6);
    }
  }
</style>
