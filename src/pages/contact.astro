---
/**
 * Contact — location cards, the weekly hours, the form and a map slot.
 * With a second file in the locations collection the cards become a grid.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@studio/core/components/Container.astro";
import Button from "@studio/core/components/Button.astro";
import SectionHeading from "@studio/core/components/SectionHeading.astro";
import LocationCard from "../components/LocationCard.astro";
import { t, business, contactFormAction, mapEmbedUrl } from "../lib/site";
import { getLocations, openingHours, groupedHours, hoursRowLabel, formatAddress } from "../lib/locations";
import { cafeSchema } from "@studio/core/utils/seo";

const locations = await getLocations();
const primary = locations.find((l) => l.data.primary) ?? locations[0];

/* Hours come from one place: the location file. The fixed table that used to
   sit here read a second, hand-typed set from the dictionary, so editing the
   markdown — which is what the documentation tells you to do — left this table
   showing the old times. */
const weekly = groupedHours(primary, t);

const schema = cafeSchema({
  /* The same id on all three pages: one business, one node. Without it,
     three pages describing one shop are three nodes with the same name,
     address and phone but three different urls, and nothing says they
     are the same place. */
  id: new URL("/#business", Astro.site).toString(),
  name: business.name,
  /* The description of the BUSINESS, not of this page. The contact page
     passed its own subtitle here, so the machine answer to "what is this
     place" was an invitation to fill in a form. */
  description: t("about.summary"),
  /* The canonical page for the business, not the page this markup is on. */
  url: new URL("/", Astro.site).toString(),
  image: new URL("/og.jpg", Astro.site).toString(),
  foundingDate: business.foundingYear,
  telephone: business.phone,
  email: business.email,
  priceRange: business.priceRange,
  servesCuisine: business.servesCuisine,
  acceptsReservations: false,
  streetAddress: primary?.data.streetAddress,
  addressLocality: primary?.data.addressLocality,
  addressRegion: primary?.data.addressRegion,
  postalCode: primary?.data.postalCode,
  addressCountry: primary?.data.addressCountry,
  openingHours: primary ? openingHours(primary) : [],
});
---

<BaseLayout title={t("nav.contact")} description={t("contact.subtitle")} schema={schema}>
  <section class="contact">
    <Container>
      <SectionHeading
        eyebrow={t("contact.eyebrow")}
        title={t("contact.title")}
        subtitle={t("contact.subtitle")}
        level="h1"
      />

      <div class="contact__grid">
        <div class="contact__locations">
          <ul
            class:list={["contact__loc-list", locations.length > 1 && "contact__loc-list--multi"]}
          >
            {
              locations.map((loc) => (
                <li>
                  <LocationCard location={loc} showAllHours headingLevel="h2" />
                </li>
              ))
            }
          </ul>

          <div class="contact__hours">
            <h2 class="contact__subtitle">{t("contact.hoursTitle")}</h2>
            <dl class="contact__hours-list">
              {
                weekly.map((row) => (
                  <div class="contact__hours-row">
                    <dt>{hoursRowLabel(row, t)}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          {/* A definition list, not a heading plus two paragraphs. The
              heading used to read "Email" above a block that also held the
              phone number, so one of the two lines was filed under the wrong
              label. */}
          <dl class="contact__direct">
            <dt>{t("contact.info.email")}</dt>
            <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
            {
              business.phone && (
                <>
                  <dt>{t("contact.info.phone")}</dt>
                  <dd>
                    <a href={`tel:${business.phone.replace(/\s/g, "")}`}>{business.phone}</a>
                  </dd>
                </>
              )
            }
            {
              primary && (
                <>
                  <dt>{t("contact.info.address")}</dt>
                  <dd>{formatAddress(primary)}</dd>
                </>
              )
            }
          </dl>
        </div>

        <div class="contact__form-wrap">
          <h2 class="contact__subtitle">{t("contact.formTitle")}</h2>
          <form class="contact__form" action={contactFormAction} method="POST">
            <div class="contact__field">
              <label for="contact-name">
                {t("contact.form.name")} <span class="contact__req">{t("contact.form.required")}</span>
              </label>
              <input id="contact-name" name="name" type="text" required autocomplete="name" aria-describedby="contact-name-error" />
              <p class="contact__error" id="contact-name-error">{t("contact.form.errName")}</p>
            </div>
            <div class="contact__field">
              <label for="contact-email">
                {t("contact.form.email")} <span class="contact__req">{t("contact.form.required")}</span>
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-describedby="contact-email-error"
                placeholder={t("contact.form.emailPlaceholder")}
              />
              <p class="contact__error" id="contact-email-error">{t("contact.form.errEmail")}</p>
            </div>
            <div class="contact__field">
              <label for="contact-message">
                {t("contact.form.message")} <span class="contact__req">{t("contact.form.required")}</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                aria-describedby="contact-message-error"
                placeholder={t("contact.form.messagePlaceholder")}></textarea>
              <p class="contact__error" id="contact-message-error">{t("contact.form.errMessage")}</p>
            </div>

            {/* Honeypot: a bot fills this in, a person never sees it */}
            <div class="contact__hp" aria-hidden="true">
              <label for="contact-company">{t("contact.honeypotLabel")}</label>
              <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <Button type="submit" variant="primary">{t("contact.form.submit")}</Button>
          </form>
        </div>
      </div>

      {/* The map. Set `mapEmbedUrl` in src/lib/site.ts and this section
          appears; leave it empty and the page never shows a grey box where a
          map should be. */}
      {
        mapEmbedUrl && (
          <div class="contact__map">
            <iframe
              src={mapEmbedUrl}
              title={t("contact.mapAlt")}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: var(--ts-space-16) var(--ts-section-y);
  }
  .contact__grid {
    margin-top: var(--ts-space-12);
    display: grid;
    /* `minmax(0, 1fr)`, not the implicit `auto`. An auto track is sized by its
       content and cannot go below it: at 200% text the single column measured
       460px inside a 240px box and the page scrolled sideways. `min-width: 0`
       on the children does not help — the track is the thing that will not
       shrink. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ts-space-12);
  }
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--ts-space-16);
      align-items: start;
    }
  }
  .contact__locations {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-10);
    min-width: 0;
  }
  .contact__loc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ts-space-6);
  }
  @media (min-width: 640px) {
    .contact__loc-list--multi {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .contact__subtitle {
    margin: 0 0 var(--ts-space-4);
    font-family: var(--ts-font-display);
    font-size: var(--ts-text-xl);
    font-weight: var(--ts-weight-semibold);
    line-height: var(--ts-leading-snug);
    color: var(--ts-color-primary-900);
  }
  .contact__hours-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-2);
    font-size: var(--ts-text-sm);
    max-width: min(24rem, 100%);
  }
  .contact__hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--ts-space-4);
    padding-bottom: var(--ts-space-2);
    border-bottom: 1px solid var(--ts-border);
    flex-wrap: wrap;
  }
  .contact__hours-row dt {
    color: var(--ts-text-muted);
  }
  .contact__hours-row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--ts-color-primary-700);
  }
  .contact__direct {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ts-space-1);
    margin: 0;
    font-size: var(--ts-text-sm);
  }
  .contact__direct dt {
    color: var(--ts-text-muted);
  }
  .contact__direct dd {
    margin: 0 0 var(--ts-space-2);
  }
  /* The aspect ratio is declared so the row reserves its height before the
     embed loads, and the border keeps the frame from floating on the ground
     colour. */
  .contact__map {
    margin-top: var(--ts-space-12);
    border: 1px solid var(--ts-border);
    border-radius: var(--ts-radius-lg);
    overflow: hidden;
  }
  .contact__map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  .contact__direct a {
    /* An e-mail address has no spaces to break at, so it sets a minimum width
       the box cannot go below. */
    overflow-wrap: anywhere;
    color: var(--ts-color-accent-600);
    /* 16.7px tall before this. inline-flex is what lets a link have a height
       at all; the phone number is the one control a person taps while walking. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-5);
    max-width: min(30rem, 100%);
  }
  .contact__field {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-1);
  }
  .contact__field label {
    font-size: var(--ts-text-sm);
    font-weight: var(--ts-weight-medium);
    color: var(--ts-color-primary-700);
  }
  .contact__field input,
  .contact__field textarea {
    min-height: 44px;
    padding: var(--ts-space-3);
    font: inherit;
    font-size: var(--ts-text-base);
    color: var(--ts-c-input-text);
    background: var(--ts-c-input-bg);
    border: 1px solid var(--ts-c-input-border);
    border-radius: var(--ts-c-input-radius);
  }
  .contact__field textarea {
    resize: vertical;
  }
  .contact__field input::placeholder,
  .contact__field textarea::placeholder {
    color: var(--ts-c-input-placeholder);
  }
  .contact__field input:focus-visible,
  .contact__field textarea:focus-visible {
    outline: none;
    border-color: var(--ts-c-input-border-focus);
    box-shadow: var(--ts-focus-ring);
  }
  /* Error display. Measured: submitting the empty form left NO trace on the
     page — no field was marked, no message stayed visible, and nothing was
     announced to a screen reader. The only feedback was the browser's own
     bubble, whose language follows the browser rather than the document.
     The `:user-invalid` hook was already available and unused.
     These rules come AFTER the focus rule on purpose: same specificity, so
     the later one wins, and the focus rule was overriding the error colour. */
  .contact__req {
    font-weight: var(--ts-weight-regular);
    color: var(--ts-text-muted);
  }
  .contact__error {
    display: none;
    margin: var(--ts-space-1) 0 0;
    font-size: var(--ts-text-sm);
    color: var(--ts-color-error);
  }
  .contact__field input:user-invalid,
  .contact__field textarea:user-invalid {
    border-color: var(--ts-color-error);
  }
  .contact__field input:user-invalid ~ .contact__error,
  .contact__field textarea:user-invalid ~ .contact__error {
    display: block;
  }
  .contact__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
