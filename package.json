{
  "name": "larkin",
  "private": true,
  "version": "1.0.2",
  "description": "A café site built around the four things people check: where, when, what, and can I work here",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node -e \"require('fs').rmSync('node_modules/.astro', { recursive: true, force: true })\"",
    "build": "astro build",
    "preview": "astro preview",
    "cms": "node scripts/cms.mjs",
    "check": "node -e \"try{require.resolve('@astrojs/check');require.resolve('typescript')}catch{console.error('astro check needs @astrojs/check and typescript. Run: npm install');process.exit(1)}\" && astro check"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@studio/core": "file:./core",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
  "alderthemes": {
    "yourFiles": [
      "src/content/",
      "src/i18n/*.json",
      "src/lib/site.ts",
      "src/styles/global.css",
      "cms/fields.json",
      "src/assets/images/",
      "public/og.jpg",
      "public/favicon.svg",
      "public/_headers"
    ]
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Alder Themes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alderthemes/larkin.git"
  },
  "homepage": "https://larkin.alderthemes.com",
  "keywords": [
    "astro",
    "astro-template",
    "tailwindcss",
    "cafe",
    "larkin"
  ]
}
