---
/**
 * CroppedImage — one photograph, two crops, one download.
 *
 * A full-width band is a different shape on a phone than on a laptop: wide and
 * short on one, upright on the other. Serving a single file and letting
 * `object-fit: cover` do the cropping means the browser downloads every pixel
 * it is about to throw away — on the cafe hero that was two thirds of the
 * file, on the largest paint of the page, which is exactly where it hurts.
 *
 * So both crops are cut at build time and offered through a `<picture>`: the
 * browser picks one and downloads one. The narrow crop is the fallback `<img>`
 * because a browser that ignores `<source>` is a small screen often enough.
 *
 * This is a mechanism, not art direction — which shapes, and which photograph,
 * stay with the theme.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Aspect ratio above the breakpoint, as [width, height]. */
  wide: [number, number];
  /** Aspect ratio below it. */
  narrow: [number, number];
  /** Where the two crops swap over, in px. */
  breakpoint?: number;
  /** Rendered widths to generate for each crop. */
  wideWidths?: number[];
  narrowWidths?: number[];
  sizes?: string;
  /** The hero of a page: skip lazy loading and ask for priority. */
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  wide,
  narrow,
  breakpoint = 768,
  wideWidths = [960, 1280, 1600, 1920],
  narrowWidths = [420, 640, 840],
  sizes = "100vw",
  eager = false,
  class: className,
} = Astro.props;

/** Height that gives `width` the requested ratio. */
const heightFor = (width: number, [rw, rh]: [number, number]) => Math.round((width * rh) / rw);

const wideMax = wideWidths[wideWidths.length - 1];
const narrowMax = narrowWidths[narrowWidths.length - 1];

const wideImage = await getImage({
  src,
  width: wideMax,
  height: heightFor(wideMax, wide),
  widths: wideWidths,
  fit: "cover",
  position: "center",
  format: "webp",
});

const narrowImage = await getImage({
  src,
  width: narrowMax,
  height: heightFor(narrowMax, narrow),
  widths: narrowWidths,
  fit: "cover",
  position: "center",
  format: "webp",
});
---

<picture>
  <source
    media={`(min-width: ${breakpoint}px)`}
    srcset={wideImage.srcSet.attribute}
    sizes={sizes}
    width={wideMax}
    height={heightFor(wideMax, wide)}
  />
  <img
    src={narrowImage.src}
    srcset={narrowImage.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={narrowMax}
    height={heightFor(narrowMax, narrow)}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    class={className}
  />
</picture>
