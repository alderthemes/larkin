---
/**
 * The legal page template, generated from the legal collection (privacy,
 * terms). Adding a file to that collection adds a page.
 *
 * The title is printed on the bag; the text itself is set on a cream label,
 * in a reading column.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "@studio/core/components/Container.astro";
import { formatUpdated, isoDate } from "@studio/core/utils/legal";
import { t, LOCALE } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("legal");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

/* `updated` is a day in the front matter ("2026-10-01"); the collection
   schema reads it as midnight UTC. The machine gets it back as YYYY-MM-DD in
   `datetime`; the reader gets it spelled for LOCALE ("October 1, 2026" /
   "1 Ekim 2026") by core, in UTC, so the day never shifts with the build
   machine's time zone.

   The sentence around the date is the dictionary's ("Last updated {date}"),
   so each language puts the date where it belongs. It is split at {date} to
   keep the date inside its <time> element. A dictionary from before the
   placeholder ("Last updated", no {date}) still builds: the date follows
   after a colon, as it used to. */
const updated = entry.data.updated;
const updatedLabel = formatUpdated(updated, LOCALE);
const sentence = t("legal.updated");
const parts = sentence.includes("{date}") ? sentence.split("{date}") : [`${sentence}: `, ""];
if (parts.length !== 2) {
  throw new Error(`legal.updated in src/i18n/${LOCALE}.json must contain {date} once: ${JSON.stringify(sentence)}`);
}
const [beforeDate, afterDate] = parts;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <section class="legal">
    <Container size="narrow">
      <h1 class="legal__title">{entry.data.title}</h1>
      <p class="legal__updated">
        {beforeDate}<time datetime={isoDate(updated)}>{updatedLabel}</time>{afterDate}
      </p>
      <div class="legal__body larkin-panel larkin-panel--label">
        <Content />
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }
  .legal__title {
    margin: 0;
    font-family: var(--ts-font-display);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    overflow-wrap: break-word;
  }
  .legal__updated {
    margin: var(--ts-space-4) 0 0;
    font-weight: 550;
  }
  .legal__body {
    margin: clamp(1.75rem, 4vw, 3rem) calc(-1 * var(--larkin-rim)) 0;
    padding-block: clamp(2rem, 4vw, 3.25rem);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .legal__body > :global(:first-child) {
    margin-top: 0;
  }
  .legal__body :global(h2) {
    font-family: var(--ts-font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: var(--ts-space-10) 0 var(--ts-space-3);
  }
  /* On a phone the long label is cut into a stack of labels: each section
     heading is printed on the bag in the gap between two of them. Every
     piece keeps the label's rounded die-cut: the cream above the gap ends
     in two rounded corners and the cream below starts with two (the pseudo
     elements are the label continuing into the gap), so no cream edge is
     left square. */
  @media (max-width: 899.98px) {
    .legal {
      padding-bottom: var(--ts-space-20);
    }
    /* The label sits on the text edge, the bag showing round it. */
    .legal__body {
      margin: var(--ts-space-10) 0 0;
    }
    .legal__body :global(h2) {
      position: relative;
      margin: var(--ts-space-2) calc(-1 * var(--ts-container-pad)) var(--ts-space-2);
      padding: calc(var(--larkin-cut-label) + var(--ts-space-10)) var(--ts-container-pad)
        calc(var(--larkin-cut-label) + var(--ts-space-8));
      background: var(--larkin-bag);
      color: var(--larkin-on-color);
    }
    .legal__body :global(h2)::before,
    .legal__body :global(h2)::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: var(--larkin-cut-label);
      background: var(--larkin-label);
    }
    .legal__body :global(h2)::before {
      top: 0;
      border-radius: 0 0 var(--larkin-cut-label) var(--larkin-cut-label);
    }
    .legal__body :global(h2)::after {
      bottom: 0;
      border-radius: var(--larkin-cut-label) var(--larkin-cut-label) 0 0;
    }
  }
  /* On a wide screen the label is wider than the reading column it holds,
     so the margin round the text is label, not bag. */
  @media (min-width: 900px) {
    .legal__body {
      margin-inline: calc(-1 * clamp(2rem, 5vw, 5rem));
      padding-inline: clamp(2.5rem, 6vw, 6rem);
    }
  }
  .legal__body :global(p),
  .legal__body :global(li) {
    color: var(--ts-text-muted);
    max-width: var(--ts-prose-max);
  }
  .legal__body :global(p) {
    margin: 0 0 var(--ts-space-4);
  }
  .legal__body :global(strong) {
    color: var(--ts-text);
  }
  .legal__body :global(a) {
    color: var(--ts-text);
    font-weight: 600;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }
</style>
