---
/**
 * Container — supplies the page's horizontal gutter, and optionally a maximum
 * width.
 *
 * The gutter comes from one token (--ts-container-pad) and never varies by
 * size, so two sections using different sizes still start at the same x on a
 * narrow screen. Width is what the size chooses.
 */
interface Props {
  /**
   * "bleed" is the sheet: no maximum at all, gutter only. It is the storefront
   * default, because the thing being sold is a screenshot and every pixel of
   * dead gutter is a screenshot rendered smaller than it needed to be.
   *
   * "prose" is a reading column, not a layout width: use it for a block that
   * is mostly sentences. "narrow", "default" and "wide" are layout, and a
   * page that mixes them with "bleed" gets a ragged left edge — pick one
   * family per page and let a reading measure be the exception.
   */
  size?: "bleed" | "default" | "narrow" | "wide" | "prose";
  class?: string;
}
const { size = "default", class: className = "" } = Astro.props;
const WIDTHS = {
  bleed: "none",
  prose: "var(--ts-prose-max)",
  narrow: "48rem",
  wide: "80rem",
  default: "var(--ts-container-max)",
};
const maxWidth = WIDTHS[size] ?? WIDTHS.default;
---

<div class:list={["ts-container", className]} style={`max-width:${maxWidth}`}>
  <slot />
</div>

<style>
  .ts-container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--ts-container-pad);
  }
</style>
