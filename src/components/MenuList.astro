---
/**
 * MenuList — the menu, grouped by category.
 * A list rather than a table: name and description on the left, price and
 * tags on the right. Seasonal items carry an accent badge, because the
 * seasonal rotation is what regulars come back to check. An empty category
 * does not vanish silently — it shows an empty state, so a mistake in the
 * content is visible rather than invisible.
 */
import type { CollectionEntry } from "astro:content";
import { t } from "../lib/site";

type MenuEntry = CollectionEntry<"menu">;

interface Props {
  items: MenuEntry[];
  /** Category order. Falls back to the order the content appears in. */
  categories?: string[];
  /** Give category headings an id, so the sticky nav can jump to them */
  withAnchors?: boolean;
  headingLevel?: "h2" | "h3";
  class?: string;
}

const CATEGORY_ORDER = ["espresso", "brew", "food", "seasonal"];
const {
  items,
  categories = CATEGORY_ORDER,
  withAnchors = false,
  headingLevel: Heading = "h2",
  class: className = "",
} = Astro.props;

const groups = categories.map((category) => ({
  category,
  label: t(`menu.categories.${category}`),
  items: items
    .filter((i) => i.data.category === category && i.data.available)
    .sort((a, b) => a.data.order - b.data.order),
}));

const price = (value: number, currency: string) =>
  new Intl.NumberFormat("en-US", {
    style: "currency",
    currency,
    minimumFractionDigits: value % 1 === 0 ? 0 : 2,
  }).format(value);
---

<div class:list={["menu-list", className]}>
  {
    groups.map((group) => (
      <section class="menu-list__group" id={withAnchors ? group.category : undefined}>
        <Heading class="menu-list__category">{group.label}</Heading>

        {group.items.length === 0 ? (
          <p class="menu-list__empty">{t("menu.empty")}</p>
        ) : (
          <ul class="menu-list__items">
            {group.items.map((item) => (
              <li class="menu-list__item">
                <div class="menu-list__body">
                  <p class="menu-list__name">
                    {item.data.name}
                    {item.data.seasonal && (
                      <span class="menu-list__badge">{t("menu.seasonalBadge")}</span>
                    )}
                  </p>
                  {item.data.description && (
                    <p class="menu-list__desc">{item.data.description}</p>
                  )}
                  {item.data.tags.length > 0 && (
                    <ul class="menu-list__tags">
                      {item.data.tags.map((tag) => (
                        <li class="menu-list__tag">{t(`menu.tags.${tag}`)}</li>
                      ))}
                    </ul>
                  )}
                </div>
                <p class="menu-list__price">{price(item.data.price, item.data.currency)}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .menu-list {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-12);
  }
  .menu-list__group {
    scroll-margin-top: calc(var(--ts-c-nav-height, 64px) + var(--ts-space-16));
  }
  /* A narrowed small capital, not a second display heading. At 31px the
     category was the same size as the section title above it and the page had
     two headings competing for the same job. */
  .menu-list__category {
    margin: 0 0 var(--ts-space-4);
    font-size: var(--larkin-label-size);
    font-weight: var(--ts-weight-medium);
    font-stretch: var(--larkin-label-width);
    letter-spacing: var(--larkin-label-tracking);
    text-transform: uppercase;
    color: var(--ts-text-subtle);
    padding-bottom: var(--ts-space-3);
    border-bottom: 1px solid var(--ts-border);
  }
  .menu-list__empty {
    margin: 0;
    font-size: var(--ts-text-sm);
    font-style: italic;
    color: var(--ts-text-muted);
  }
  .menu-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The price sits at the column edge with an open corridor between it and
     the name. That is the arrangement for a menu of short entries; the
     restaurant theme, whose dishes carry two lines of description each, sets
     its prices against the name instead. Neither uses a leader of dots. */
  .menu-list__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ts-space-8);
    padding: var(--ts-space-4) 0;
    border-bottom: 1px solid var(--ts-border);
  }
  .menu-list__item:last-child {
    border-bottom: none;
  }

  .menu-list__body {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-1);
  }
  .menu-list__name {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--ts-space-3);
    font-size: var(--ts-text-lg);
    font-weight: var(--ts-weight-medium);
    color: var(--ts-text);
  }
  /* The one place the terracotta appears. The seasonal rotation is what a
     regular is scanning the menu for, so it is what earns the colour — and it
     works as a mark rather than as a filled chip precisely because nothing
     else on the page is coloured. */
  .menu-list__badge {
    font-size: var(--larkin-label-size);
    font-weight: var(--ts-weight-medium);
    font-stretch: var(--larkin-label-width);
    letter-spacing: var(--larkin-label-tracking);
    text-transform: uppercase;
    color: var(--ts-color-accent-600);
  }
  .menu-list__desc {
    margin: 0;
    font-size: var(--ts-text-sm);
    line-height: var(--ts-leading-body);
    color: var(--ts-text-muted);
    max-width: var(--ts-prose-max);
  }
  .menu-list__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ts-space-2);
    margin: var(--ts-space-1) 0 0;
    padding: 0;
  }
  /* A note, not a chip. A filled box around "Decaf available" gives it the
     weight of a promotion; set as quiet type it reads as what it is. */
  .menu-list__tag {
    font-size: var(--ts-text-xs);
    color: var(--ts-text-subtle);
  }
  .menu-list__tag + .menu-list__tag::before {
    content: "·";
    margin-inline-end: var(--ts-space-2);
  }
  .menu-list__price {
    margin: 0;
    flex-shrink: 0;
    font-size: var(--ts-text-base);
    font-variant-numeric: tabular-nums;
    color: var(--ts-text-muted);
  }
</style>
