---
/**
 * About — the short story and how the coffee is sourced and roasted.
 * The "summary" paragraph is written to be quotable on its own: it is the
 * sentence an answer engine lifts when someone asks about the shop.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@studio/core/components/Container.astro";
import SectionHeading from "@studio/core/components/SectionHeading.astro";
import { t, business } from "../lib/site";
import { getPrimaryLocation, openingHours } from "../lib/locations";
import { cafeSchema } from "@studio/core/utils/seo";

const primary = await getPrimaryLocation();

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/images/*.jpg", {
  eager: true,
});
const storyImage = images["../assets/images/02-bar.jpg"]?.default;

/* `src` is the smallest candidate, not the largest: srcset decides what a
   modern browser fetches, and `src` is only the fallback for one that cannot
   read srcset. */
const story = storyImage
  ? await (async () => {
      const [small, large] = await Promise.all([
        getImage({ src: storyImage, width: 520, format: "webp" }),
        getImage({ src: storyImage, width: 780, format: "webp" }),
      ]);
      return {
        src: small.src,
        srcset: `${small.src} 520w, ${large.src} 780w`,
        width: small.attributes.width,
        height: small.attributes.height,
      };
    })()
  : null;

const schema = cafeSchema({
  /* The same id on all three pages: one business, one node. Without it,
     three pages describing one shop are three nodes with the same name,
     address and phone but three different urls, and nothing says they
     are the same place. */
  id: new URL("/#business", Astro.site).toString(),
  name: business.name,
  /* The description of the BUSINESS, not of this page. The contact page
     passed its own subtitle here, so the machine answer to "what is this
     place" was an invitation to fill in a form. */
  description: t("about.summary"),
  /* The canonical page for the business, not the page this markup is on. */
  url: new URL("/", Astro.site).toString(),
  image: new URL("/og.jpg", Astro.site).toString(),
  foundingDate: business.foundingYear,
  telephone: business.phone,
  email: business.email,
  priceRange: business.priceRange,
  servesCuisine: business.servesCuisine,
  acceptsReservations: false,
  streetAddress: primary?.data.streetAddress,
  addressLocality: primary?.data.addressLocality,
  addressRegion: primary?.data.addressRegion,
  postalCode: primary?.data.postalCode,
  addressCountry: primary?.data.addressCountry,
  openingHours: primary ? openingHours(primary) : [],
});
---

<BaseLayout title={t("nav.about")} description={t("about.summary")} schema={schema}>
  <section class="about">
    <Container>
      <div class="about__grid">
        <div class="about__text">
          <SectionHeading
            eyebrow={t("about.eyebrow")}
            title={t("about.title")}
            level="h1"
          />
          <p class="about__lead">{t("about.lead")}</p>
          <p class="about__summary">{t("about.summary")}</p>
        </div>

        {
          story && (
            <div class="about__media">
              <img
                src={story.src}
                srcset={story.srcset}
                sizes="(min-width: 1440px) 610px, (min-width: 1024px) calc((100vw - 144px) / 2.1), 100vw"
                width={story.width}
                height={story.height}
                alt={t("about.imageAlt")}
                loading="eager"
                decoding="async"
                class="about__img"
              />
            </div>
          )
        }
      </div>

      <div class="about__blocks">
        <article class="about__block">
          <h2 class="about__block-title">{t("about.sourcingTitle")}</h2>
          <p class="about__block-body">{t("about.sourcingBody")}</p>
        </article>
        <article class="about__block">
          <h2 class="about__block-title">{t("about.roastTitle")}</h2>
          <p class="about__block-body">{t("about.roastBody")}</p>
        </article>
        <article class="about__block">
          <h2 class="about__block-title">{t("about.nameTitle")}</h2>
          <p class="about__block-body">{t("about.nameBody")}</p>
        </article>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--ts-space-16) var(--ts-section-y);
  }
  .about__grid {
    display: grid;
    gap: var(--ts-space-10);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--ts-space-16);
    }
  }
  .about__lead {
    margin: var(--ts-space-6) 0 0;
    font-size: var(--ts-text-lg);
    line-height: var(--ts-leading-body);
    color: var(--ts-color-primary-700);
    max-width: 52ch;
  }
  .about__summary {
    margin: var(--ts-space-4) 0 0;
    font-size: var(--ts-text-base);
    line-height: var(--ts-leading-body);
    color: var(--ts-text-muted);
    max-width: 58ch;
  }
  .about__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--ts-radius-xl);
  }
  .about__blocks {
    margin-top: var(--ts-space-16);
    display: grid;
    gap: var(--ts-space-8);
  }
  @media (min-width: 768px) {
    .about__blocks {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .about__block {
    padding-top: var(--ts-space-5);
    border-top: 2px solid var(--ts-color-accent-400);
  }
  .about__block-title {
    margin: 0 0 var(--ts-space-3);
    font-family: var(--ts-font-display);
    font-size: var(--ts-text-xl);
    font-weight: var(--ts-weight-semibold);
    line-height: var(--ts-leading-snug);
    color: var(--ts-color-primary-900);
  }
  .about__block-body {
    margin: 0;
    font-size: var(--ts-text-sm);
    line-height: var(--ts-leading-body);
    color: var(--ts-text-muted);
  }
</style>
