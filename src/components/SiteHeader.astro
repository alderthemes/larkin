---
/**
 * SiteHeader — the sticky navigation and the mobile menu.
 * The mobile menu is details/summary and CSS only: no JavaScript, and
 * keyboard and screen-reader behavior come from the browser.
 * The call to action is directions, not a booking: a cafe takes walk-ins, and
 * a reserve button here would promise something the business does not do.
 */
import Container from "@studio/core/components/Container.astro";
import Button from "@studio/core/components/Button.astro";
import { t } from "../lib/site";
import { getPrimaryLocation } from "../lib/locations";

const links = [
  { href: "/", label: t("nav.home") },
  { href: "/menu/", label: t("nav.menu") },
  { href: "/about/", label: t("nav.about") },
  { href: "/contact/", label: t("nav.contact") },
];
const current = Astro.url.pathname;
const primary = await getPrimaryLocation();
const ctaHref = primary?.data.mapUrl ?? "/contact/";
const external = Boolean(primary?.data.mapUrl);
---

<header class="site-header">
  <Container>
    <div class="site-header__inner">
      <a href="/" class="site-header__brand">
        <svg class="site-header__mark" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 27c0-7 4-11 10-12-1 7-4 11-10 12Z" />
          <path d="M16 27C16 19 12 15 6 14c1 7 4 11 10 13Z" />
          <path d="M16 27V13" />
        </svg>
        <span>{t("site.name")}</span>
      </a>

      <nav aria-label={t("a11y.mainNav")} class="site-header__desktop">
        <ul class="site-header__nav">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={current === l.href ? "page" : undefined}
                  class="site-header__link"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <span class="site-header__cta">
        <Button
          href={ctaHref}
          variant="primary"
          size="sm"
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {t("nav.cta")}
          {external && <span class="ts-visually-hidden"> ({t("a11y.externalLink")})</span>}
        </Button>
      </span>

      <details class="site-header__mobile">
        {/* No aria-label here. A label is a fixed string, and this control
            has two states: after opening it, a screen reader still read
            "Open menu" on the button that now closes it. A <summary> already
            announces expanded/collapsed on its own — it only needed a name,
            so the name is real text, hidden visually. */}
        <summary class="site-header__toggle">
          <span class="site-header__bars" aria-hidden="true"
            ><span></span><span></span><span></span></span
          >
          <span class="ts-visually-hidden">{t("nav.menu")}</span>
        </summary>
        <nav aria-label={t("a11y.mainNav")} class="site-header__panel">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={current === l.href ? "page" : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={ctaHref}
                class="site-header__panel-cta"
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                {t("nav.cta")}
                {external && <span class="ts-visually-hidden"> ({t("a11y.externalLink")})</span>}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </Container>
</header>

<script type="module" src="/menu-close.js"></script>

<style>
  /* Printed across the top of the bag: cream on terracotta, and sticky, so
     the way to the shop is always one tap away. The bar is the bag itself,
     not a frosted strip over it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--ts-z-header);
    background: var(--larkin-bag);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--ts-space-2) var(--ts-space-4);
    /* Exactly the nav height token: the menu page's category bar and every
       scroll margin on the site are measured from it. */
    min-height: var(--ts-c-nav-height);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--ts-space-2);
    min-height: 44px;
    /* The brand may wrap and may shrink. `white-space: nowrap` plus the
       default `min-width: auto` pushed the menu button off the screen with a
       long business name, and again at 200% text size. */
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--ts-font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--larkin-on-color);
    text-decoration: none;
    margin-right: auto;
  }
  .site-header__mark {
    flex: none;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .site-header__desktop {
    display: none;
  }
  .site-header__nav {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--ts-space-1);
  }
  /* The underline is printed, not bordered: it draws out from the left under
     the pointer and stays drawn under the current page. On the bag it is
     cream, because terracotta cannot mark terracotta. */
  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--ts-space-3);
    color: var(--larkin-on-color);
    text-decoration: none;
    font-weight: var(--ts-weight-semibold);
    font-size: 0.9375rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: var(--ts-space-3) calc(100% - 8px);
    background-size: 0 2px;
    transition: background-size calc(0.3s * var(--larkin-motion, 1)) var(--ts-ease-out);
  }
  .site-header__link:hover,
  .site-header__link[aria-current="page"] {
    background-size: calc(100% - 2 * var(--ts-space-3)) 2px;
  }
  .site-header__cta :global(.ts-btn) {
    white-space: nowrap;
  }

  /* --- Mobile --- */
  .site-header__mobile {
    position: relative;
  }
  .site-header__toggle {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--ts-radius-full);
    border: 2px solid var(--larkin-on-color);
    color: var(--larkin-on-color);
    cursor: pointer;
  }
  .site-header__toggle::-webkit-details-marker {
    display: none;
  }
  /* The control's name is real text, hidden visually. Its box is pinned
     to the middle of the ring at a hair's size, so nothing of it sits on
     or past the edge of the control: the text has no footprint because it
     has no look. */
  .site-header__toggle {
    position: relative;
  }
  .site-header__toggle :global(.ts-visually-hidden) {
    top: 50%;
    left: 50%;
    font-size: 0.0625rem;
    line-height: 1;
  }
  .site-header__bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .site-header__bars span {
    width: 16px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform calc(var(--ts-duration-fast) * var(--larkin-motion, 1)) var(--ts-ease-out),
      opacity calc(var(--ts-duration-fast) * var(--larkin-motion, 1)) var(--ts-ease-out);
  }
  .site-header__mobile[open] .site-header__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header__mobile[open] .site-header__bars span:nth-child(2) {
    opacity: 0;
  }
  .site-header__mobile[open] .site-header__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  /* The open menu is a sticker on the bag: label paper, ink type. */
  .site-header__panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--ts-space-3));
    min-width: 220px;
    background: var(--larkin-sticker);
    color: var(--ts-text);
    border-radius: var(--larkin-cut-label);
    padding: var(--ts-space-3);
    --ts-focus-ring: 0 0 0 2px var(--larkin-sticker), 0 0 0 5px var(--ts-text);
  }
  .site-header__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-1);
  }
  .site-header__panel a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: var(--ts-space-4);
    border-radius: var(--ts-radius-full);
    text-decoration: none;
    color: var(--ts-text);
    font-weight: var(--ts-weight-semibold);
  }
  .site-header__panel a:hover,
  .site-header__panel a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .site-header__panel-cta {
    background: var(--ts-text);
    color: var(--larkin-sticker) !important;
    justify-content: center;
    margin-top: var(--ts-space-2);
  }
  .site-header__panel-cta:hover {
    text-decoration: none !important;
    background: var(--ts-color-primary-950);
  }

  @media (min-width: 900px) {
    .site-header__desktop {
      display: block;
    }
    .site-header__mobile {
      display: none;
    }
  }
  /* Below 380px the brand, the button and the menu control no longer fit on
     one line; the button is also the last item of the open menu. */
  @media (max-width: 379.98px) {
    .site-header__cta {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .site-header__brand {
      font-size: 0.875rem;
    }
    .site-header__cta :global(.ts-btn) {
      padding-inline: var(--ts-space-3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__bars span,
    .site-header__link {
      transition: none;
    }
  }
</style>
