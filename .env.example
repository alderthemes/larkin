# Copy this file to .env and set your own domain before the first deploy.
#
# SITE is the only environment variable this project reads. It is the absolute
# address of the live site, and it is what canonical tags, Open Graph URLs,
# robots.txt and sitemap.xml are built from. Leave it unset and all of those
# say "https://example.com" — the build prints a warning and every page ships
# with <meta name="robots" content="noindex">, because being indexed under the
# wrong domain is harder to notice, and harder to undo, than not being indexed
# at all.
#
# No trailing slash.
SITE=https://your-domain.com
