---
import { MENU_CATEGORIES } from "../content.config";
/**
 * MenuList — the menu, grouped by category.
 * A list in the markup, set as a table on screen: the category in the first
 * column, then name, price, description and tags in fixed columns, so they
 * line up down the menu. Seasonal items carry an accent badge, because the
 * seasonal rotation is what regulars come back to check. An empty category
 * does not vanish silently — it shows an empty state, so a mistake in the
 * content is visible rather than invisible.
 */
import type { CollectionEntry } from "astro:content";
import { t } from "../lib/site";
import { formatPrice } from "../lib/menu";

type MenuEntry = CollectionEntry<"menu">;

interface Props {
  items: MenuEntry[];
  /** Category order. Falls back to the order the content appears in. */
  categories?: string[];
  /** Give category headings an id, so the sticky nav can jump to them */
  withAnchors?: boolean;
  headingLevel?: "h2" | "h3";
  class?: string;
}

const {
  items,
  categories = MENU_CATEGORIES,
  withAnchors = false,
  headingLevel: Heading = "h2",
  class: className = "",
} = Astro.props;

const groups = categories.map((category) => ({
  category,
  label: t(`menu.categories.${category}`),
  items: items
    .filter((i) => i.data.category === category && i.data.available)
    .sort((a, b) => a.data.order - b.data.order),
}));

---

<div class:list={["menu-list", className]}>
  {
    /* tabindex="-1" only where the section is a link target: it makes the
       category focusable by the sticky navigation without adding a stop to
       the tab order. */
    groups.map((group) => (
      <section
        class="menu-list__group"
        id={withAnchors ? group.category : undefined}
        tabindex={withAnchors ? -1 : undefined}
      >
        <Heading class="menu-list__category">{group.label}</Heading>

        {group.items.length === 0 ? (
          <p class="menu-list__empty">{t("menu.empty")}</p>
        ) : (
          <ul class="menu-list__items">
            {group.items.map((item) => (
              <li class="menu-list__item">
                <div class="menu-list__body">
                  <p class="menu-list__name">
                    {item.data.name}
                    {item.data.seasonal && (
                      <span class="menu-list__badge">{t("menu.seasonalBadge")}</span>
                    )}
                  </p>
                  {item.data.description && (
                    <p class="menu-list__desc">{item.data.description}</p>
                  )}
                  {item.data.tags.length > 0 && (
                    <ul class="menu-list__tags">
                      {item.data.tags.map((tag) => (
                        <li class="menu-list__tag">{t(`menu.tags.${tag}`)}</li>
                      ))}
                    </ul>
                  )}
                </div>
                <p class="menu-list__price">{formatPrice(item.data.price, item.data.currency)}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  /* The production table on the back label of the bag. Each category is one
     row of the table: its name in the first column, its items in the rest.
     An item is name, price, description and tags, in that order in the
     markup and on the screen; the grid only decides where each one sits.
     The columns are the same width in every row, so prices and descriptions
     line up down the whole menu however long a name is. The price column is
     at least 4.5rem and grows to the widest price in the category ("CHF
     112.50", "₺1.250,75"), never into the description.
     Colors come from the surface the list is printed on (--lk-*): ink on a
     label, cream on the gusset. */
  .menu-list {
    border-top: 2px solid var(--lk-ink, currentColor);
  }
  .menu-list__group {
    display: grid;
    gap: var(--ts-space-3);
    padding-block: var(--ts-space-5);
    border-bottom: 1px solid var(--lk-rule, currentColor);
    scroll-margin-top: calc(var(--ts-c-nav-height) + 4.5rem);
  }
  .menu-list__category {
    margin: 0;
    font-family: var(--ts-font-display);
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    overflow-wrap: break-word;
  }
  .menu-list__empty {
    margin: 0;
    font-style: italic;
    color: var(--lk-ink-soft, currentColor);
  }
  .menu-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ts-space-5);
  }
  .menu-list__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--ts-space-4);
    row-gap: var(--ts-space-1);
    align-items: baseline;
  }
  /* The wrapper only groups the markup; the grid places its children. */
  .menu-list__body {
    display: contents;
  }
  .menu-list__name {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ts-space-2);
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }
  /* The seasonal tag: the one place terracotta is a fill, cream type on it
     at 5.5:1. It is real text from the content and never tilts. */
  .menu-list__badge {
    display: inline-block;
    padding: 0.28rem 0.55rem 0.26rem;
    border-radius: 4px;
    background: var(--ts-color-accent-600);
    color: var(--larkin-on-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .menu-list__price {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .menu-list__desc {
    grid-column: 1 / -1;
    margin: var(--ts-space-1) 0 0;
    line-height: 1.55;
    color: var(--lk-ink-soft, currentColor);
    max-width: var(--ts-prose-max);
  }
  .menu-list__tags {
    grid-column: 1 / -1;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ts-space-2);
    margin: 0;
    padding: 0;
  }
  .menu-list__tag {
    font-size: 0.875rem;
    font-weight: 650;
  }
  .menu-list__tag + .menu-list__tag::before {
    content: "·";
    margin-inline-end: var(--ts-space-2);
  }

  @media (min-width: 760px) {
    .menu-list__group {
      grid-template-columns: minmax(0, 2.6fr) minmax(0, 9.4fr);
      column-gap: var(--ts-space-6);
      align-items: baseline;
    }
    /* The rows share one set of columns (subgrid), so the price column is
       as wide as the widest price and every row still lines up. */
    .menu-list__items {
      grid-template-columns: minmax(0, 3.4fr) minmax(4.5rem, max-content) minmax(0, 4.4fr) minmax(0, 2fr);
      column-gap: var(--ts-space-5);
    }
    .menu-list__item {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      column-gap: var(--ts-space-5);
    }
    .menu-list__desc {
      grid-column: 3;
      grid-row: 1;
      margin: 0;
    }
    .menu-list__tags {
      grid-column: 4;
      grid-row: 1;
      justify-content: flex-end;
      text-align: right;
    }
  }
</style>
